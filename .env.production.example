# =========================================================================
# Contoh konfigurasi PRODUKSI.
#
#   cp .env.production.example .env.production
#
# Lalu ganti SETIAP nilai bertanda GANTI. Berkas .env.production sudah
# masuk .gitignore dan tidak boleh di-commit.
# =========================================================================

APP_NAME="LearningSystem"
APP_ENV=production
APP_TIMEZONE=Asia/Jakarta

# GANTI — buat sekali saja, lalu simpan permanen:
#   php artisan key:generate --show
# Jangan dibuat ulang tiap deploy: seluruh sesi akan batal dan data
# terenkripsi (termasuk secret 2FA) tidak lagi bisa dibaca.
APP_KEY=

# Wajib false. Entrypoint akan menolak start bila true, karena mode ini
# membocorkan stack trace beserta isi variabel lingkungan ke pengunjung.
APP_DEBUG=false

# GANTI — domain sungguhan, dan HARUS https
APP_URL=https://lms.contoh.com

# -------------------------------------------------------------------------
# Database
# -------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_DATABASE=learning_system
DB_USERNAME=lms_user
# GANTI — jangan pakai "secret"/"root" seperti di setup pengembangan
DB_PASSWORD=
DB_ROOT_PASSWORD=

# -------------------------------------------------------------------------
# Sesi, cache, antrean
# -------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Cookie sesi hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# -------------------------------------------------------------------------
# Log — ke stderr agar terbaca lewat `docker logs` dan tidak hilang saat
# container dibangun ulang.
# -------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# -------------------------------------------------------------------------
# Email — WAJIB berfungsi.
# Verifikasi email adalah syarat mengakses materi; bila email gagal
# terkirim, seluruh siswa baru terkunci dan tidak bisa belajar.
# GANTI dengan penyedia sungguhan (Mailgun, Amazon SES, Postmark, dll).
# -------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@lms.contoh.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
