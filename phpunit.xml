<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Test berjalan di MySQL, mesin yang sama dengan produksi, agar
             perbedaan perilaku (mode ketat, GROUP BY, tipe kolom) tertangkap
             di test dan bukan di server. Database TERPISAH dari pengembangan
             karena RefreshDatabase menghapus seluruh tabel.
             Jalankan dari dalam container: docker compose exec app php artisan test -->
        <!-- Test memakai MySQL, mesin yang sama dengan produksi, agar perbedaan
             perilaku (mode ketat, GROUP BY, tipe kolom) tertangkap di test dan
             bukan di server.

             Yang dialihkan hanya DB_CONNECTION, menunjuk ke koneksi
             `mysql_testing` di config/database.php yang nama databasenya dikunci.
             Menimpa DB_DATABASE dari sini TIDAK BISA DIANDALKAN: docker-compose
             menaruhnya di $_SERVER, yang dibaca Laravel lebih dulu daripada $_ENV.

             Jalankan dari dalam container: docker compose exec app php artisan test -->
        <env name="DB_CONNECTION" value="mysql_testing" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
